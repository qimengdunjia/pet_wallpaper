# 文件用途：网页 Demo 后端配置模板；复制为 .env 后按需填写供应商配置，切勿提交真实密钥。
DEMO_PROVIDER=mock
DEMO_PORT=8080
DEMO_MOCK_DELAY_SECONDS=2.0
DEMO_MOCK_CONTROLS=true
DEMO_DATA_DIR=data
# 设置页密码。留空时后端首次启动在数据目录生成 settings-password。
# DEMO_SETTINGS_PASSWORD=

# 使用真实可灵 API 生成时切换 DEMO_PROVIDER=kling 并配置以下参数
# KLING_API_KEY=
# KLING_BASE_URL=https://api-beijing.klingai.com
# KLING_POLL_SECONDS=15
# KLING_TASK_TIMEOUT_SECONDS=1800

# 初始使用 ComfyUI 时选 DEMO_PROVIDER=comfyui，也可以在网页设置中切换。
# COMFYUI_BASE_URL=http://127.0.0.1:18188
# COMFYUI_POLL_SECONDS=3
# COMFYUI_TASK_TIMEOUT_SECONDS=1800
# 隧道传输受限时，可为模型参考图设置字节上限。
# COMFYUI_REFERENCE_MAX_BYTES=0
